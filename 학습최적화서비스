<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>StudySync AI - 사생활 안심 온디바이스 학습 일정 최적화</title>
  <style>
    :root {
      --primary: #2563eb;
      --bg: #f8fafc;
      --card: #ffffff;
      --text: #1e293b;
      --muted: #64748b;
      --border: #e2e8f0;
    }
    * { box-sizing: border-box; font-family: 'Pretendard', -apple-system, sans-serif; }
    body { background: var(--bg); color: var(--text); margin: 0; padding: 24px; line-height: 1.5; }
    .container { max-width: 820px; margin: 0 auto; }
    header { background: var(--card); padding: 24px; border-radius: 14px; border: 1px solid var(--border); margin-bottom: 20px; }
    .badge { display: inline-block; background: #dbeafe; color: var(--primary); font-size: 12px; font-weight: 700; padding: 4px 10px; border-radius: 99px; margin-bottom: 8px; }
    h1 { margin: 0 0 8px; font-size: 22px; }
    .desc { color: var(--muted); font-size: 14px; margin: 0; }
    .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    @media (max-width: 680px) { .grid { grid-template-columns: 1fr; } }
    .card { background: var(--card); padding: 20px; border-radius: 14px; border: 1px solid var(--border); }
    .card h2 { font-size: 16px; margin: 0 0 14px; border-bottom: 1px solid var(--border); padding-bottom: 8px; }
    label { display: block; font-size: 13px; font-weight: 600; margin-bottom: 4px; color: #334155; }
    input, select { width: 100%; padding: 9px 12px; border: 1px solid var(--border); border-radius: 8px; margin-bottom: 12px; font-size: 14px; }
    button { width: 100%; background: var(--primary); color: white; border: none; padding: 12px; border-radius: 8px; font-size: 15px; font-weight: 700; cursor: pointer; }
    button:hover { background: #1d4ed8; }
    .metric-box { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-bottom: 16px; }
    .metric { background: #f1f5f9; padding: 10px; border-radius: 8px; text-align: center; }
    .metric span { display: block; font-size: 11px; color: var(--muted); }
    .metric strong { font-size: 16px; color: var(--primary); }
    .schedule-item { padding: 10px 12px; border-left: 4px solid var(--primary); background: #f8fafc; margin-bottom: 8px; border-radius: 0 8px 8px 0; font-size: 14px; }
    .privacy-note { margin-top: 16px; font-size: 12px; color: #059669; background: #ecfdf5; padding: 10px; border-radius: 8px; }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <span class="badge">🔒 On-Device AI · 데이터 외부 전송 없음</span>
      <h1>개인별 학습 일정 최적화 서비스</h1>
      <p class="desc">허깅페이스(Hugging Face) 학습 행동 데이터 기반 속성 가공 및 동적 스케줄링 알고리즘 적용</p>
    </header>

    <div class="grid">
      <!-- 입력 패널 -->
      <div class="card">
        <h2>1. 오늘의 학습 상태 입력 (최소 데이터 수집)</h2>
        <label>목표 순수 공부 시간 (시간)</label>
        <input type="number" id="studyHours" value="4.5" step="0.5" min="1" max="14" />

        <label>어젯밤 수면 시간 (시간)</label>
        <input type="number" id="sleepHours" value="6.5" step="0.5" min="3" max="12" />

        <label>평소 일일 SNS·스마트폰 사용 시간 (시간)</label>
        <input type="number" id="socialHours" value="2.0" step="0.5" min="0" max="10" />

        <label>오늘 집중 학습할 핵심 과목 (취약/고난도)</label>
        <select id="mainSubject">
          <option value="수학 (심화 문제풀이)">수학 (심화 문제풀이)</option>
          <option value="영어 (독해 및 구문)">영어 (독해 및 구문)</option>
          <option value="과학탐구 (개념 및 추론)">과학탐구 (개념 및 추론)</option>
          <option value="국어 (비문학 독해)">국어 (비문학 독해)</option>
        </select>

        <button onclick="optimizeSchedule()">AI 맞춤 학습 일정 생성하기</button>
        <div class="privacy-note">
          ✓ 입력된 데이터는 외부 서버로 전송되지 않으며, 현재 기기 브라우저 메모리에서만 연산 후 즉시 파기됩니다.
        </div>
      </div>

      <!-- 출력 패널 -->
      <div class="card">
        <h2>2. 핵심 속성 분석 및 최적 시간표</h2>
        <div class="metric-box">
          <div class="metric">
            <span>순수 학습 몰입 지수</span>
            <strong id="focusIndex">-</strong>
          </div>
          <div class="metric">
            <span>학습-수면 균형도</span>
            <strong id="balanceIndex">-</strong>
          </div>
          <div class="metric">
            <span>비학습 시간 점유율</span>
            <strong id="distractionRate">-</strong>
          </div>
        </div>

        <div id="aiFeedback" style="font-size: 13px; color: #334155; margin-bottom: 12px; font-weight: 600;">
          왼쪽에서 학습 상태를 입력하고 버튼을 눌러주세요.
        </div>
        <div id="scheduleList"></div>
      </div>
    </div>
  </div>

  <script>
    // 허깅페이스(Zeyustun/student_exam_performance) 데이터 기반 가중치 및 속성 가공 모델
    function optimizeSchedule() {
      const study = parseFloat(document.getElementById('studyHours').value) || 0;
      const sleep = parseFloat(document.getElementById('sleepHours').value) || 0;
      const social = parseFloat(document.getElementById('socialHours').value) || 0;
      const subject = document.getElementById('mainSubject').value;

      // 1. 핵심 속성 3가지 실시간 가공 (Feature Engineering)
      const focusIndex = Math.max(0, (study - social * 0.5)).toFixed(2);
      const balanceIndex = study > 0 ? (sleep / study).toFixed(2) : 0;
      const distractionRate = (study + social) > 0 ? ((social / (study + social)) * 100).toFixed(1) : 0;

      document.getElementById('focusIndex').innerText = focusIndex + ' pt';
      document.getElementById('balanceIndex').innerText = balanceIndex;
      document.getElementById('distractionRate').innerText = distractionRate + '%';

      // 2. 피로도 및 집중도 기반 동적 스케줄 분배 로직
      let blockMinutes = 50;
      let breakMinutes = 10;
      let feedback = '';

      if (balanceIndex < 1.3) {
        blockMinutes = 35;
        breakMinutes = 15;
        feedback = '⚠️ 수면 대비 학습량이 높아 피로 누적 위험이 있습니다. 35분 학습 후 15분 휴식(짧은 블록)으로 조정했습니다.';
      } else if (distractionRate >= 35) {
        blockMinutes = 40;
        breakMinutes = 10;
        feedback = '📱 비학습(SNS) 점유율이 높습니다. 집중력 분산을 막기 위해 40분 단위 고밀도 세션을 배치했습니다.';
      } else {
        blockMinutes = 60;
        breakMinutes = 10;
        feedback = '✅ 학습-수면 균형이 안정적입니다. 고난도 과목(' + subject + ')을 앞시간에 집중 배치했습니다.';
      }

      document.getElementById('aiFeedback').innerText = feedback;

      // 3. 맞춤형 타임테이블 렌더링
      const totalMinutes = Math.round(study * 60);
      const sessions = Math.max(1, Math.floor(totalMinutes / blockMinutes));
      const listEl = document.getElementById('scheduleList');
      listEl.innerHTML = '';

      let currentHour = 17; // 방과 후 오후 5시 시작 기준
      let currentMin = 0;

      for (let i = 1; i <= sessions; i++) {
        const startStr = formatTime(currentHour, currentMin);
        addMinutes(blockMinutes);
        const endStr = formatTime(currentHour, currentMin);

        const taskName = i === 1 ? `${subject} (핵심 집중 세션)` :
                         i === 2 ? `국어/영어 지문 분석 및 어휘` :
                         i === sessions ? `당일 오답 정리 및 복습` : `탐구/암기 과목 개념 정리`;

        const div = document.createElement('div');
        div.className = 'schedule-item';
        div.innerHTML = `<strong>${startStr} ~ ${endStr}</strong> (${blockMinutes}분) · ${taskName}`;
        listEl.appendChild(div);

        addMinutes(breakMinutes);
      }

      function addMinutes(mins) {
        currentMin += mins;
        while (currentMin >= 60) {
          currentHour += 1;
          currentMin -= 60;
        }
      }

      function formatTime(h, m) {
        return `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}`;
      }
    }
  </script>
</body>
</html>
